{
  "features": [
    {
      "id": "video.permalink",
      "title": "Durable video permalink URL",
      "description": "The video playback URL becomes a durable, shareable link that survives a reload and resumes playback instead of bouncing home.",
      "owner": "web-client",
      "kind": "user-action",
      "files": ["src/components/router/appRouter.js", "src/controllers/playback/video/index.js"],
      "added": "2026-07-23",
      "paths": [
        {
          "id": "video.permalink.reload.resumes_playback",
          "type": "happy",
          "requiredAssertions": ["url_contains_item_id", "playback_resumes_after_reload"]
        },
        {
          "id": "video.permalink.autoplay_blocked.recovers_to_paused_ready",
          "type": "unhappy",
          "failureClass": "permission",
          "requiredAssertions": ["video_ready_paused", "play_button_visible"]
        },
        {
          "id": "video.permalink.fresh_tab.no_history_falls_back_home",
          "type": "unhappy",
          "failureClass": "not_found",
          "requiredAssertions": ["routes_home_instead_of_hanging"]
        }
      ]
    },
    {
      "id": "video.next_episode_back",
      "title": "Next episode then Back player navigation",
      "description": "Advancing to the next episode in-player and pressing Back exits to the launching page instead of stepping back through played episodes.",
      "owner": "web-client",
      "kind": "user-action",
      "files": ["src/components/router/appRouter.js"],
      "added": "2026-07-23",
      "paths": [
        {
          "id": "video.next_episode_back.enter_player.pushes_history_entry",
          "type": "happy",
          "requiredAssertions": ["history_entry_pushed"]
        },
        {
          "id": "video.next_episode_back.next_episode.replaces_history_entry",
          "type": "happy",
          "requiredAssertions": ["history_index_unchanged", "back_exits_to_launch_page"]
        },
        {
          "id": "video.next_episode_back.same_item_reshow.no_op",
          "type": "unhappy",
          "failureClass": "domain",
          "requiredAssertions": ["no_duplicate_navigation"]
        },
        {
          "id": "video.next_episode_back.playback_ends_no_next_item.exits_home",
          "type": "unhappy",
          "failureClass": "not_found",
          "requiredAssertions": ["routes_home_on_playback_end"]
        }
      ]
    },
    {
      "id": "playback.error_recovery",
      "title": "Fatal HLS network error recovery during playback",
      "description": "When HLS segment loading hits a fatal network error, the player retries with a bounded budget and surfaces an actionable error instead of freezing silently.",
      "owner": "web-client",
      "kind": "user-action",
      "files": ["src/components/htmlMediaHelper.js"],
      "added": "2026-07-23",
      "paths": [
        {
          "id": "playback.error_recovery.transient_error.retries_and_recovers",
          "type": "happy",
          "requiredAssertions": ["no_reject_on_single_transient_error"]
        },
        {
          "id": "playback.error_recovery.progress_resets_retry_budget",
          "type": "happy",
          "requiredAssertions": ["retry_budget_resets_on_frag_buffered"]
        },
        {
          "id": "playback.error_recovery.hung_server_at_startup.gives_up_and_rejects",
          "type": "unhappy",
          "failureClass": "network",
          "requiredAssertions": ["rejects_with_network_error_once"]
        },
        {
          "id": "playback.error_recovery.hung_server_steady_state.surfaces_error",
          "type": "unhappy",
          "failureClass": "timeout",
          "requiredAssertions": ["error_event_surfaced_once"]
        }
      ]
    },
    {
      "id": "audio_transcode.resume",
      "title": "Resume playback of an audio-transcode item",
      "description": "Resuming an item whose audio requires transcoding from a mid-file position starts playback and keeps it advancing instead of freezing on one frame.",
      "owner": "web-client",
      "kind": "user-action",
      "files": ["src/components/htmlMediaHelper.js", "e2e/audio-transcode-resume.spec.ts"],
      "added": "2026-07-23",
      "paths": [
        {
          "id": "audio_transcode.resume.mid_file_position.advances_without_freezing",
          "type": "happy",
          "requiredAssertions": ["current_time_advances"]
        },
        {
          "id": "audio_transcode.resume.hung_segment_at_startup.retries_then_surfaces",
          "type": "unhappy",
          "failureClass": "network",
          "requiredAssertions": ["rejects_with_network_error_once"]
        },
        {
          "id": "audio_transcode.resume.steady_state_stall.surfaces_instead_of_freezing",
          "type": "unhappy",
          "failureClass": "timeout",
          "requiredAssertions": ["error_event_surfaced_once"]
        }
      ]
    },
    {
